pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                echo 'Cloning repository...'
                git branch: 'main', url: 'https://github.com/Vatsa285/DevOPS.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Docker image...'
                dir('Assignments/Assignment3-VisualCraft-AI') {
                    sh 'docker build -t visualcraft-ai:1.0 .'
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                dir('Assignments/Assignment3-VisualCraft-AI') {
                    sh '''
                    pip install -r requirements.txt
                    python -m unittest test_app.py -v
                    '''
                }
            }
        }

        stage('Security Scan') {
            steps {
                echo 'Running security scan on Docker image...'
                sh 'docker inspect visualcraft-ai:1.0 --format="{{.Config.User}}"'
                echo 'Security scan passed.'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying to Kubernetes...'
                dir('Assignments/Assignment3-VisualCraft-AI') {
                    sh 'kubectl apply -f k8s-deployment.yaml'
                    sh 'kubectl rollout status deployment/visualcraft-ai'
                }
            }
        }

        stage('Smoke Test') {
            steps {
                echo 'Running smoke tests...'
                sh 'sleep 10'
                sh 'kubectl get pods -l app=visualcraft-ai'
                echo 'Smoke tests passed!'
            }
        }
    }

    post {
        success {
            echo 'VisualCraft AI deployed successfully!'
        }
        failure {
            echo 'Deployment failed! Rolling back...'
            sh 'kubectl rollout undo deployment/visualcraft-ai || true'
        }
    }
}
